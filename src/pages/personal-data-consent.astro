---
import PageLayout from '@/layouts/PageLayout.astro';
import Consent from '@/content/personal-data-consent.mdx';
import settings from '@/data/settings.json';
const { site_name, brand, legal_entity, legal_inn, legal_city, phone_common, email_common } = settings;
import scripts from '@/data/scripts.json';
const { site } = scripts;
import salonsData from '@/data/salons.json';
import type { ISalon } from '@/types/ISalon';
const salons = salonsData.filter((salon: ISalon) => !salon?.type || salon?.type.includes('privacy_policy'));
---

<PageLayout
    h1="Согласие на обработку персональных данных"
    title="Согласие на обработку персональных данных"
    description={`Согласие на обработку персональных данных`}
    breadcrumb={[{name:"Согласие на обработку персональных данных",href:""}]}
>
    <Consent />
</PageLayout>
