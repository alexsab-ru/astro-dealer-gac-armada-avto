---
import Layout from '@/layouts/Layout.astro';
import FeedbackForm from '@/components/FeedbackForm/FeedbackForm.astro';
import settings from '@/data/site/settings.json';
import PageH1 from '@/components/PageH1/Index.astro';
import InfoItem from '@/components/Info/Item.astro';
import Button from '@/components/Button/Button.astro';
import modelsData from '@/data/site/models.json';
const { brand, legal_city_where, site_name } = settings;

// Фильтруем только видимые модели
const availableModels = modelsData.models.filter(model => model.show && model.status === 'enable');

const infoItemClasses = "flex flex-col-reverse items-center justify-end gap-4 text-center bg-gray-100 p-5 rounded-xl";
const infoItems = [
	{
		title: `<span class="text-lg lg:text-xl font-semibold">Выгодно</span><span class="block text-sm text-gray-500 mt-1">Выгода по кредиту суммируется с выгодой по трейд-ин</span>`,
		icon: "mdi:hand-coin",
		iconClasses: "text-accent-500 size-16"
	},
	{
		title: `<span class="text-lg lg:text-xl font-semibold">Быстро</span><span class="block text-sm text-gray-500 mt-1">Оформление занимает минимум времени, ответ в кратчайшие сроки</span>`,
		icon: "mdi:flash",
		iconClasses: "text-accent-500 size-16"
	},
	{
		title: `<span class="text-lg lg:text-xl font-semibold">На любой срок</span><span class="block text-sm text-gray-500 mt-1">Срок кредитования до 96 месяцев</span>`,
		icon: "mdi:calendar-clock",
		iconClasses: "text-accent-500 size-16"
	}
];
---

<Layout title={`Купить ${brand} в кредит — кредитные программы у официального дилера в ${legal_city_where} | ${site_name}`} description={`Купить автомобили ${brand} в кредит у официального дилера в ${legal_city_where}, выгодные программы кредитования. Рассчитать автокредит на автомобили ${brand}. ►Узнайте об условиях кредитования и специальных предложениях ►Первоначальный взнос от 0% ►До 96 месяцев`}>
	<div class="container py-10 space-y-10">
		
		<PageH1 h1={`Оформление кредита без посещения банка
на выгодных условиях`} classes="text-3xl sm:text-4xl text-center" />
		
		<section class="p-0!">
			<p class="text-center mb-4 text-gray-500">Наши три ключевых преимущества — это то, что делает процесс
				оформления кредита максимально удобным:</p>
			<div class="grid gap-4 sm:grid-cols-3">
				{infoItems.map(item => (
					<InfoItem item={item} classes={infoItemClasses} />
				))}
			</div>
		</section>

		<!-- Вкладки с моделями -->
		<section x-data={`{
			models: ${JSON.stringify(availableModels.map(m => ({ id: m.id, name: m.name, thumb: m.thumb })))},
			tabActive: '${availableModels[0]?.id || ''}',
			creditInfo: {
				term: 'до 96 месяцев',
				rate: 'от 0,01%',
				initialPayment: 'от 20%'
			},
			scroll(){
				document.getElementById('activeModel')?.scrollIntoView({
					behavior: 'smooth',
					block: 'start'
				})
			}
		}`} class="space-y-8">
			<h2 class="text-2xl md:text-3xl font-bold text-center">Программы кредитования на выгодных условиях специально для клиентов GAC</h2>
			
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				<template x-for="model in models" :key="model.id">
					<div 
						class="cursor-pointer opacity-50 transition-all duration-300 hover:opacity-80 text-center p-4 border rounded-lg flex flex-col items-center justify-center gap-3"
						:class="{'!opacity-100 bg-accent-500 text-white border-accent-500': tabActive === model.id}"
						@click="tabActive = model.id; scroll()"
					>
						<img 
							:src="model.thumb" 
							:alt="model.name"
							class="w-full h-24 object-contain"
						/>
						<span class="font-bold text-lg" x-text="model.name"></span>
					</div>
				</template>
			</div>

			<!-- Кредитные предложения -->
			<div id="activeModel" class="grid md:grid-cols-2 gap-6">
				<!-- Блок Тинькофф -->
				<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
					<div class="space-y-4">
						<!-- Логотип банка Tinkoff -->
						<div class="flex justify-center mb-4">
							<div class="h-16 flex items-center justify-center px-6">
								<img src="https://cdn.alexsab.ru/logo/banks/t-bank.svg" width="200" alt="Т-Банк">
							</div>
						</div>
						
						<!-- Параметры кредита -->
						<div class="space-y-3">
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Срок кредитования:</span>
								<span class="font-semibold"><span x-text="creditInfo.term"></span><sup>1</sup></span>
							</div>
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Минимальная ставка:</span>
								<span class="font-semibold"><span x-text="creditInfo.rate"></span><sup>1</sup></span>
							</div>
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Первоначальный взнос:</span>
								<span class="font-semibold"><span x-text="creditInfo.initialPayment"></span><sup>1</sup></span>
							</div>
						</div>
						
						<!-- Кнопка -->
						<Button 
							view="popup-link"
							url="#common-modal"
							title="Отправить заявку"
							dataTitle='Отправить заявку'
							classes="block w-full bg-accent-500 hover:bg-accent-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors mt-6 text-center"
							x-bind:data-form_name="'Программы кредитования на выгодных условиях специально для клиентов GAC. ' + (models.find(m => m.id === tabActive)?.name || '')"
						/>
					</div>
				</div>

				<!-- Блок Альфа-Банк -->
				<div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
					<div class="space-y-4">
						<!-- Логотип банка Альфа -->
						<div class="flex justify-center mb-4">
							<div class="h-16 flex items-center justify-center px-6">
								<img src="https://cdn.alexsab.ru/logo/banks/alfabank-horizontal.svg" width="200" alt="Альфа Банк">
							</div>
						</div>
						
						<!-- Параметры кредита -->
						<div class="space-y-3">
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Срок кредитования:</span>
								<span class="font-semibold"><span x-text="creditInfo.term"></span><sup>2</sup></span>
							</div>
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Минимальная ставка:</span>
								<span class="font-semibold"><span x-text="creditInfo.rate"></span><sup>2</sup></span>
							</div>
							<div class="flex justify-between items-center py-2 border-b border-gray-100">
								<span class="text-gray-600">Первоначальный взнос:</span>
								<span class="font-semibold"><span x-text="creditInfo.initialPayment"></span><sup>2</sup></span>
							</div>
						</div>
						
						<!-- Кнопка -->
						<Button 
							view="popup-link"
							url="#common-modal"
							title="Отправить заявку"
							dataTitle='Отправить заявку'
							classes="block w-full bg-accent-500 hover:bg-accent-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors mt-6 text-center"
							x-bind:data-form_name="'Программы кредитования на выгодных условиях специально для клиентов GAC. ' + (models.find(m => m.id === tabActive)?.name || '')"
						/>
					</div>
				</div>
			</div>
		</section>

		<FeedbackForm title="Получить предложение по кредиту" dataFormName="Получить предложение по кредиту" showModelSelect={true} />

		<h3 class="mt-20">Подробная информация</h3>
		<p><strong><sup>1</sup> Т‑Банк</strong></p>
		<p>
			Предложение по тарифному плану «Акция 0 GAC DIRECT ПВ от 20% до 80% БИ» распространяется на новые автомобили 2024-2025 года выпуска. Диапазон полной стоимости потребительского кредита (ПСК) в % годовых составляет 0,619% - 33,369%.
			Процентная ставка по кредиту 0,01%-17,0% годовых, срок кредитования 12-96 мес., первоначальный взнос от 20% до 80%.
		</p>
		<p>Указанные условия действуют при обязательном оформлении страхования по КАСКО или опции «Свобода от КАСКО». При отсутствии пролонгации/отказе от полиса КАСКО или опции «Свобода от КАСКО» ставка увеличится на 3%.</p>
		<p>Обеспечение по кредиту — залог приобретаемого автомобиля. Сумма кредита от 100 000 руб. до 12 000 000 руб..</p>
		<p>Условия кредитования актуальны на 17.11.2025 г. Условия и тарифы могут быть изменены банком в одностороннем порядке. Банк в праве отказать в выдаче автокредита. Подробности уточняйте в салонах и на сайте официального дилера: https://gac.ru/. Предложение ограничено, носит информационный характер, не является публичной офертой. Кредит предоставляется АО ТБанк, ОГРН 1027739642281 ИНН 7710140679, адрес: 127287, город Москва, ул. Хуторская 2-Я, д. 38а стр. 26. Генеральная лицензия №2673 от 09.07.2024.</p>
		<p><strong>Оценивайте свои финансовые возможности и риски.</strong> Изучите все условия кредита (залога) на сайте: https://www.tbank.ru/loans/auto-loan/programs/.</p>

		<p><strong><sup>2</sup> Альфа Банк</strong></p>
		<p>
			Предложение распространяется на новые автомобили GAC 2024-2025 годов производства и действует в салонах официальных дилеров марки GAC. 
			Параметры программ «GAC Direct GS8», «GAC Direct GS8 +», «GAC Direct GS3», «GAC Direct GS3 +», «GAC Direct M8», «GAC Direct M8 +», «GAC Direct GS4+EPW», «GAC Direct GS4+EPW +»: валюта кредита – рубли РФ; срок кредита – 12-24 мес.; сумма кредита - от 100 000 до 10 000 000 руб.
		</p>

		<p>Диапазон Полной стоимости кредита в % годовых составляет от 0,005% до 0,310%. % ставка составляет 0,010%, при сроке кредита 12 мес. и диапазоне первоначального взноса от 70,000% до 99,999% от стоимости автомобиля, при сроке кредита 24 мес. и диапазоне первоначального взноса от 80,000% до 99,999% от стоимости автомобиля.</p>
		<p>
			Ставка определяется индивидуально. <strong>Оценивайте свои финансовые возможности и риски.</strong>* Подробнее уточняйте в официальных дилерских центрах GAC.
			* Изучите все условия кредита в разделе «Кредит на покупку автомобиля у дилера» на сайте банка https://alfabank.ru/get-money/auto-loan/dealers/?platformId=alfasite
		</p>
		<p>
			Кредит предоставляет АО Альфа-Банк. ИНН 7728168971 ОГРН 1027700067328 место нахождение 107078, г. Москва, ул. Каланчевская, д. 27.  
			Ген.лицензия ЦБ РФ № 1326 от 16.01.2015. Предложение ограничено и не является публичной офертой.
		</p>
	</div>
</Layout>
